# Layer 2: Frappe Bench Image
# Extends Layer 1a (dev-bench-base) with Frappe-specific tools
# Includes: Database clients, Nginx, Redis tools, Python debuggers
# For polyglot stack: Python, Node, MariaDB, Redis, Nginx

ARG BASE_IMAGE=dev-bench-base:latest
FROM ${BASE_IMAGE}

# Container version labels
LABEL layer="2"
LABEL layer.name="frappe-bench"
LABEL layer.version="2.1.0"
LABEL layer.updated="2026-03-07"
LABEL layer.description="Frappe development and diagnostic tools"
LABEL bench.type="frappe"

# Template build args (for faster workspace bootstrap)
ARG FRAPPE_BRANCH=version-15
ARG FRAPPE_PYTHON_BIN=python3
ARG FRAPPE_TEMPLATE_DIR=/opt/frappe-bench-template
ARG ERPNEXT_REPO=https://github.com/frappe/erpnext
ARG ERPNEXT_BRANCH=version-15
ARG PAYMENTS_REPO=https://github.com/frappe/payments
ARG PAYMENTS_BRANCH=version-15

# Expose template location for runtime scripts
ENV FRAPPE_TEMPLATE_DIR=${FRAPPE_TEMPLATE_DIR}

# Switch to root for Frappe-specific package installation
USER root

# ========================================
# FRAPPE-SPECIFIC PACKAGES
# ========================================

# Install Frappe stack dependencies and diagnostic tools
RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    && apt-get -y install --no-install-recommends \
    # Database
    mariadb-client \
    libmysqlclient-dev \
    # SSL/TLS
    libssl-dev \
    openssl \
    # Web server
    nginx \
    # Redis
    redis-tools \
    # Network diagnostics (curl already in Layer 0)
    dnsutils \
    netcat-openbsd \
    # Log viewing
    multitail \
    # PDF generation (required for Frappe print formats)
    wkhtmltopdf \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ========================================
# DOCKER CLI (daemon runs on host via mounted socket)
# ========================================

RUN curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-27.5.1.tgz \
    | tar xz --strip-components=1 -C /usr/local/bin docker/docker \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
       https://github.com/docker/compose/releases/download/v2.34.0/docker-compose-linux-x86_64 \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# ========================================
# PYTHON DIAGNOSTIC TOOLS
# ========================================

# Install Python performance and debugging tools
RUN pip3 install --break-system-packages \
    py-spy \
    web-pdb \
    frappe-bench \
    ruff \
    pre-commit \
    coverage \
    && pip3 cache purge

# ========================================
# NODE.JS VERSION PIN (Frappe requires Node 18 or 20)
# ========================================
# The base image has Node.js LTS (currently v24) but Frappe only supports 18/20.
# Must remove the existing nodesource repo first, then add the v20 repo.
RUN rm -f /etc/apt/sources.list.d/nodesource.list \
    && rm -f /etc/apt/keyrings/nodesource.gpg \
    && apt-get update && apt-get remove -y nodejs || true \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && node --version | grep -q '^v20' && echo "✓ Node.js $(node --version) pinned for Frappe" \
    || { echo "✗ Expected Node.js v20, got $(node --version)"; exit 1; }

# ========================================
# BENCH TEMPLATE (SPEED UP NEW WORKSPACES)
# ========================================

# Create a temporary build user (bench refuses to run as root)
RUN useradd -m -s /bin/bash _benchbuild

# Prepare template location
RUN mkdir -p /opt && chown _benchbuild:_benchbuild /opt

# Build bench template as temporary user
USER _benchbuild
ENV COREPACK_HOME=/tmp/corepack
RUN mkdir -p /tmp/corepack && bench init "${FRAPPE_TEMPLATE_DIR}" \
        --frappe-branch "${FRAPPE_BRANCH}" \
        --python "${FRAPPE_PYTHON_BIN}" \
        --skip-redis-config-generation \
        --verbose \
    && cd "${FRAPPE_TEMPLATE_DIR}" \
    && bench get-app --branch "${ERPNEXT_BRANCH}" "${ERPNEXT_REPO}" \
    && bench get-app --branch "${PAYMENTS_BRANCH}" "${PAYMENTS_REPO}" \
    && bench setup requirements \
    && "${FRAPPE_TEMPLATE_DIR}/env/bin/pip" install -e apps/frappe \
    && "${FRAPPE_TEMPLATE_DIR}/env/bin/pip" install -e apps/erpnext \
    && "${FRAPPE_TEMPLATE_DIR}/env/bin/pip" install -e apps/payments \
    && touch "${FRAPPE_TEMPLATE_DIR}/.bench-requirements-ok"

# Note: multitail already installed above for log viewing
# tailspin skipped due to download issues - use multitail instead

# Switch back to root for remaining config
USER root

# ========================================
# SHELL CONFIGURATION (into /etc/skel)
# ========================================

# Make template readable by all users and owned by root
RUN chown -R root:root "${FRAPPE_TEMPLATE_DIR}" && chmod -R a+rX "${FRAPPE_TEMPLATE_DIR}"

# Clean up temporary build user
RUN userdel -r _benchbuild 2>/dev/null || true

# Add Frappe diagnostic aliases to /etc/skel/.zshrc
RUN echo '' >> /etc/skel/.zshrc && \
    echo '# Frappe diagnostic aliases' >> /etc/skel/.zshrc && \
    echo 'alias nginx-debug="nginx -t && tail -n 50 /var/log/nginx/error.log"' >> /etc/skel/.zshrc && \
    echo 'alias frappe-doctor="bench doctor"' >> /etc/skel/.zshrc && \
    echo 'alias redis-monitor="redis-cli monitor"' >> /etc/skel/.zshrc && \
    echo 'alias check-workers="ps aux | grep -E \"(gunicorn|node|redis|bench)\""' >> /etc/skel/.zshrc

# Default command
CMD ["sleep", "infinity"]
